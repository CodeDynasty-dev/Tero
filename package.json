{
  "name": "tero",
  "version": "0.1.0",
  "description": "Tero is a JSON database that provides ACID transactions, automated cloud backup, and automatic cloud recovery",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./acid-engine": {
      "types": "./dist/acid-engine.d.ts",
      "import": "./dist/acid-engine.js"
    },
    "./backup": {
      "types": "./dist/backup.d.ts",
      "import": "./dist/backup.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codedynasty-dev/tero.git"
  },
  "author": "friday candour fridaycandours@gmail.com",
  "bugs": {
    "url": "https://github.com/codedynasty-dev/tero/issues"
  },
  "homepage": "https://github.com/codedynasty-dev/tero.git",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node run-tests.js",
    "test:sanity": "node tests/sanity-test.js",
    "test:issues": "node --test tests/issue-fixes.test.js",
    "test:hydration": "node --test tests/gradual-hydration.test.js",
    "test:fault": "node --test tests/fault-injection.test.js",
    "test:cloud": "node --test tests/cloud-resilience.test.js",
    "test:concurrency": "node --test tests/concurrency-chaos.test.js",
    "test:fuzz": "node --test tests/fuzz-oracle.test.js",
    "test:chaos": "node tests/chaos-test.js",
    "test:production": "node tests/prod-test-suite.js",
    "test:s3": "node tests/s3-live-backup-test.js",
    "test:all": "node run-tests.js",
    "test:watch": "npm run test",
    "verify": "node run-tests.js",
    "ci": "node run-tests.js",
    "bench": "node tests/run-bench.js --synchronous normal",
    "bench:full": "node tests/run-bench.js --synchronous full",
    "bench:quick": "node tests/run-bench.js --quick --synchronous normal",
    "bench:live": "node tests/run-live-bench.js",
    "bench:live:quick": "node tests/run-live-bench.js --quick"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "JSON",
    "database",
    "javascript"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/lib-storage": "^3.1120.0",
    "cron": "^4.3.2",
    "quick-lru": "^7.0.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/cron": "^2.0.1",
    "@types/node": "^24.0.14",
    "@types/quick-lru": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
